{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://actum.network/schemas/actum-work-prover-source-v1.schema.json",
  "title": "Actum Work Prover Source v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "class", "epoch", "events"],
  "properties": {
    "schema": {"const": "actum.work-claim.source.v1"},
    "class": {"enum": ["attention", "compute", "contribution"]},
    "epoch": {"$ref": "#/$defs/sealed_epoch"},
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/signed_event"}
    }
  },
  "$defs": {
    "digest384": {"type": "string", "pattern": "^[0-9a-f]{96}$"},
    "lower_hex": {"type": "string", "pattern": "^[0-9a-f]+$"},
    "sealed_epoch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["epoch_envelope_hex", "epoch_id"],
      "properties": {
        "epoch_envelope_hex": {"$ref": "#/$defs/lower_hex", "maxLength": 2048},
        "epoch_id": {"$ref": "#/$defs/digest384"}
      }
    },
    "signed_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["event_envelope_hex", "event_id", "algorithm_revision", "collector_public_key_hex", "signature_hex"],
      "properties": {
        "event_envelope_hex": {"$ref": "#/$defs/lower_hex", "maxLength": 2048},
        "event_id": {"$ref": "#/$defs/digest384"},
        "algorithm_revision": {"const": 1},
        "collector_public_key_hex": {"$ref": "#/$defs/lower_hex", "maxLength": 2624},
        "signature_hex": {"$ref": "#/$defs/lower_hex", "maxLength": 4840}
      }
    }
  }
}
