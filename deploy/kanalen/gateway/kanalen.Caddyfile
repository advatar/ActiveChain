# BEGIN activechain-kanalen
kanalen.actum.network, kanalen.activechain.dev {
	header {
		Cache-Control "no-store"
		Content-Type "text/plain; charset=utf-8"
		X-Content-Type-Options "nosniff"
	}
	respond "ActiveChain Kanalen — developmental network infrastructure. No security audit has been completed. Do not use it for value you are unwilling to lose. RPC: rpc.kanalen.actum.network:443. Telemetry anchor: anchor.kanalen.actum.network." 200
}

anchor.kanalen.actum.network {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy host.docker.internal:49156
}

verify.kanalen.actum.network {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy host.docker.internal:49157
}

delivery.kanalen.actum.network, delivery.kanalen.activechain.dev {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}
	reverse_proxy host.docker.internal:49158
}

# END activechain-kanalen
